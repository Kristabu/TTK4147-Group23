# Build artifacts
**/build/
**/dist/
**/out/
**/*.o
**/*.so
**/*.a
**/*.exe

# IDE and editor-specific files
.vscode/
.idea/
*.swp
*.swo
*.bak

# Temporary files
*.tmp
*.log
*.cache
.DS_Store
Thumbs.db
*.lock
*.pid

# Compressed files
*.zip

# Python virtual environments
venv/
__pycache__/
*.pyc
*.pyo

# Node.js dependencies (if applicable)
node_modules/
npm-debug.log
yarn.lock

# Other files to ignore
*:Zone.Identifier*

# Microchip Studio / Visual Studio user-specific files
.vs/
*.user
*.suo
*.userosscache
*.sln.docstates

# Build output
Debug/
Release/

# Intermediate build files
obj/
*.o
*.d
*.elf
*.hex
*.eep
*.map
*.lss
*.a

# AVR / Microchip Studio generated files
*.atsuo
*.componentinfo.xml
*.vc.db

# Generated dependency files
*.dep

# Programmer/debugger generated files
*.elfsym
*.elfsections
*.elfsections.xml

# OS/editor junk
.DS_Store
Thumbs.db
